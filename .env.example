POSTGRES_DB=graffy
POSTGRES_USER=graffy
POSTGRES_PASSWORD=graffy_password
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=graffy;Username=graffy;Password=graffy_password

JWT_SECRET=change-this-secret-in-production
JWT_ISSUER=graffy
JWT_AUDIENCE=graffy
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

NEXT_PUBLIC_API_URL=http://localhost:8000
STATIC_BASE_URL=http://localhost:8000

# Production с доменом (docker-compose.prod.yml + init-letsencrypt.sh)
# DOMAIN=graffy.example.com
# CERTBOT_EMAIL=admin@example.com
# NEXT_PUBLIC_API_URL=https://graffy.example.com
# STATIC_BASE_URL=https://graffy.example.com

# Production без домена (docker-compose.prod.yml + docker-compose.prod.ip.yml)
# HTTP_PORT=80
# NEXT_PUBLIC_API_URL=http://203.0.113.10
# STATIC_BASE_URL=http://203.0.113.10
# Если HTTP_PORT=8080, укажите :8080 в URL выше

ADMIN_EMAIL=admin@graffy.local
ADMIN_PASSWORD=admin12345
